{
  "name": "gikan",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev:api": "npm run dev -w @gikan/api",
    "dev:web": "npm run dev -w @gikan/web",
    "build": "npm run build -w @gikan/web && npm run build -w @gikan/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w @gikan/api",
    "db:migrate": "npm run db:migrate -w @gikan/api"
  }
}
