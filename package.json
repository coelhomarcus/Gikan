{
  "name": "gikan",
  "private": true,
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "dev:api": "pnpm --filter @gikan/api dev",
    "dev:web": "pnpm --filter @gikan/web dev",
    "build": "pnpm --filter @gikan/web build && pnpm --filter @gikan/api build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @gikan/api db:generate",
    "db:migrate": "pnpm --filter @gikan/api db:migrate"
  }
}
